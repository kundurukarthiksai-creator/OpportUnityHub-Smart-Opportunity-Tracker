# SUPABASE CONFIGURATION
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-or-anon-key

# SECURITY & AUTHENTICATION
JWT_SECRET=your-jwt-signing-secret-key-change-this-in-production
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-for-oauth-token-encryption

# GOOGLE OAUTH 2.0 CREDENTIALS
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# AI CONFIGURATION (Use Gemini or OpenAI or both)
# GEMINI CONFIG (Recommended, free tier available)
GEMINI_API_KEY=your-gemini-api-key

# OPENAI CONFIG (Alternative)
OPENAI_API_KEY=your-openai-api-key
AI_PROVIDER=gemini  # 'gemini' or 'openai'
